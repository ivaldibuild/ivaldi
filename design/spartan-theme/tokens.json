{
  "$description": "Ivaldi theme for Spartan UI. Colour roles follow the Spartan UI Figma kit's Theme collection (Light/Dark). Geometry follows the kit's Lyra style (radius 0) with Vega control sizes. Mirrors ivaldi.css: change both together.",
  "style": {
    "geometry": "lyra",
    "density": "vega",
    "radius": "0rem"
  },
  "modes": {
    "forge": {
      "class": "dark",
      "default": true,
      "tokens": {
        "background": "#0b0f14",
        "foreground": "#e7ded1",
        "card": "#0b0f14",
        "card-foreground": "#e7ded1",
        "popover": "#374151",
        "popover-foreground": "#e7ded1",
        "primary": "#b87333",
        "primary-foreground": "#0b0f14",
        "secondary": "#374151",
        "secondary-foreground": "#ffffff",
        "muted": "#374151",
        "muted-foreground": "rgba(231, 222, 209, 0.72)",
        "accent": "#374151",
        "accent-foreground": "#ffffff",
        "destructive": "#9a3f2d",
        "destructive-foreground": "#ffffff",
        "border": "#374151",
        "input": "rgba(231, 222, 209, 0.5)",
        "ring": "#e7ded1",
        "chart-1": "#b87333",
        "chart-2": "#e7ded1",
        "chart-3": "#9a3f2d",
        "chart-4": "#f7f3ed",
        "chart-5": "#374151",
        "sidebar": "#0b0f14",
        "sidebar-foreground": "#e7ded1",
        "sidebar-primary": "#b87333",
        "sidebar-primary-foreground": "#0b0f14",
        "sidebar-accent": "#374151",
        "sidebar-accent-foreground": "#ffffff",
        "sidebar-border": "#374151",
        "sidebar-ring": "#e7ded1",
        "heading": "#ffffff",
        "eyebrow": "#b87333",
        "primary-text": "#b87333",
        "overlay": "rgba(11, 15, 20, 0.8)"
      }
    },
    "paper": {
      "class": "light",
      "tokens": {
        "background": "#f7f3ed",
        "foreground": "#0b0f14",
        "card": "#ffffff",
        "card-foreground": "#0b0f14",
        "popover": "#ffffff",
        "popover-foreground": "#0b0f14",
        "primary": "#b87333",
        "primary-foreground": "#0b0f14",
        "secondary": "#e7ded1",
        "secondary-foreground": "#0b0f14",
        "muted": "#e7ded1",
        "muted-foreground": "#374151",
        "accent": "#e7ded1",
        "accent-foreground": "#0b0f14",
        "destructive": "#9a3f2d",
        "destructive-foreground": "#ffffff",
        "border": "#e7ded1",
        "input": "#374151",
        "ring": "#374151",
        "chart-1": "#b87333",
        "chart-2": "#374151",
        "chart-3": "#9a3f2d",
        "chart-4": "#0b0f14",
        "chart-5": "#e7ded1",
        "sidebar": "#ffffff",
        "sidebar-foreground": "#0b0f14",
        "sidebar-primary": "#b87333",
        "sidebar-primary-foreground": "#0b0f14",
        "sidebar-accent": "#e7ded1",
        "sidebar-accent-foreground": "#0b0f14",
        "sidebar-border": "#e7ded1",
        "sidebar-ring": "#374151",
        "radius": "0rem",
        "font-sans": "Inter, system-ui, -apple-system, sans-serif",
        "font-mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "heading": "#0b0f14",
        "eyebrow": "#374151",
        "primary-text": "#0b0f14",
        "overlay": "rgba(11, 15, 20, 0.6)"
      }
    }
  },
  "controls": {
    "control-h-xs": "1.5rem",
    "control-h-sm": "2rem",
    "control-h": "2.25rem",
    "control-h-lg": "2.5rem",
    "control-px": "0.625rem",
    "card-spacing": "1.5rem"
  }
}
